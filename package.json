{
  "name": "glassmarshmallow-icons",
  "version": "0.4.0",
  "description": "Line and fill icons for GlassMarshmallow, with the same names as Bootstrap Icons.",
  "author": "Sara Paez Yamuza",
  "license": "MIT",
  "homepage": "https://glassmarshmallow.com/icons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GlassMarshmallow/glassmarshmallow-icons.git"
  },
  "bugs": {
    "url": "https://github.com/GlassMarshmallow/glassmarshmallow-icons/issues"
  },
  "keywords": [
    "icons",
    "svg",
    "icon-font",
    "glassmarshmallow"
  ],
  "files": [
    "icons/*.svg",
    "font/glassmarshmallow-icons.css",
    "icons.json"
  ],
  "style": "font/glassmarshmallow-icons.css",
  "scripts": {
    "icons": "python3 source/draw.py",
